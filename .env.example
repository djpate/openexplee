# OpenExplee Configuration
HOST=0.0.0.0
PORT=8000
DATABASE_PATH=data/openexplee.db

# Docker: host port the UI is published on (docker-compose.yml)
OPENEXPLEE_PORT=8010

# LLM Providers for AI Research & Copywriting (Add at least one)
# Options: anthropic | gemini | openai | groq | ollama
DEFAULT_LLM_PROVIDER=anthropic
DEFAULT_LLM_MODEL=claude-opus-5-5

# API Keys
GEMINI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GROQ_API_KEY=

# Claude model and effort used when DEFAULT_LLM_PROVIDER=anthropic
ANTHROPIC_MODEL=claude-opus-5-5
ANTHROPIC_EFFORT=low

# Local Ollama (if using local offline models).
# In Docker, use http://host.docker.internal:11434 to reach Ollama on the host.
OLLAMA_BASE_URL=http://host.docker.internal:11434

# Upstream defaults these to the original author's private machine
# (100.114.48.60). Point them at the host so the LLM fallback chain never
# tries to reach someone else's server.
THOR_OLLAMA_URL=http://host.docker.internal:11434
THOR_CDP_URL=http://host.docker.internal:9222

# Sender identity
# Sign-off name on AI-written emails
SENDER_NAME=
# Your real inbox: Cloudflare reply forwarding + DMARC reports
FORWARD_TO_EMAIL=
# CC'd on replies sent from the Mailbox (blank = no CC)
REPLY_CC_EMAIL=
# Your booking link (e.g. Cal.com), used in email CTAs (blank = no link)
BOOKING_URL=
# Your main domain(s), comma-separated; sending inboxes on these are refused
PROTECTED_PRIMARY_DOMAINS=

# Compliance footer added to every cold email and follow-up.
# CAN-SPAM requires a physical postal address in commercial email.
POSTAL_ADDRESS=
# Uncomment to change the default opt-out line:
# OPT_OUT_LINE=Not the right fit? Just reply "unsubscribe" and I won't email you again.

# Optional: Serper API Key for Google Search (Falls back to free DuckDuckGo if blank)
SERPER_API_KEY=

# Outreach Deliverability Guardrails
MAX_DAILY_SENDS_PER_INBOX=35
MIN_DELAY_SECONDS=120
MAX_DELAY_SECONDS=300
WARMUP_ENABLED=true
WARMUP_DAILY_TARGET=15
