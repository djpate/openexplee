{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "openexplee-cf-mailer",
  "main": "src/index.ts",
  "compatibility_date": "2026-05-20",
  "compatibility_flags": ["nodejs_compat"],
  "send_email": [
    {
      "name": "EMAIL"
    }
  ],
  "vars": {
    // Your real inbox. Inbound replies are forwarded here; leave empty to disable forwarding.
    "FORWARD_TO_EMAIL": ""
  }
}

